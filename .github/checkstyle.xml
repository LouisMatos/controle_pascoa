<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Configuração Checkstyle — Sistema Páscoa
  Foco: regras práticas sem bloquear código existente com Lombok/Spring.
  violationSeverity=warning no CI (não bloqueia build inicial).
  Para ativar bloqueio: alterar para "error" em pom.xml perfil ci.
-->
<module name="Checker">
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <!-- Proibir tabs (usar espaços) -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- Arquivo deve terminar com nova linha -->
    <module name="NewlineAtEndOfFile">
        <property name="lineSeparator" value="lf, crlf"/>
    </module>

    <module name="TreeWalker">

        <!-- ── Imports ─────────────────────────────────────────────────── -->
        <!-- Sem wildcard: import java.util.* não permitido -->
        <module name="AvoidStarImport"/>

        <!-- Sem imports não utilizados -->
        <module name="UnusedImports">
            <property name="processJavadoc" value="false"/>
        </module>

        <!-- Sem imports duplicados -->
        <module name="RedundantImport"/>

        <!-- ── Tamanho ──────────────────────────────────────────────────── -->
        <!-- Máximo 150 caracteres por linha (ignora imports/packages/URLs) -->
        <module name="LineLength">
            <property name="max" value="150"/>
            <property name="ignorePattern" value="^package.*|^import.*|https?://|ftp://"/>
        </module>

        <!-- ── Chaves e Blocos ──────────────────────────────────────────── -->
        <!-- Chaves obrigatórias em if/else/for/while/do -->
        <module name="NeedBraces"/>

        <!-- Blocos catch vazios só permitidos com comentário ou variável nomeada "ignore/expected" -->
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="ignore|expected|ignored"/>
        </module>

        <!-- ── Modificadores ────────────────────────────────────────────── -->
        <!-- Ordem dos modificadores: public protected private abstract static... -->
        <module name="ModifierOrder"/>

        <!-- ── Código Morto ─────────────────────────────────────────────── -->
        <!-- Sem declarações desnecessárias de throws -->
        <module name="RedundantThrows"/>

    </module>
</module>
