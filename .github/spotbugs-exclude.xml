<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0
        https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!--
      Exclusões SpotBugs — falsos positivos comuns com Lombok + Spring Boot
    -->

    <!-- Lombok @Data gera getters que expõem arrays/coleções mutáveis -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Spring usa reflexão para injetar dependências — SpotBugs reporta como não inicializado -->
    <Match>
        <Bug pattern="UWF_UNWRITTEN_FIELD,UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/>
    </Match>

    <!-- Lombok @Builder gera classes internas — SpotBugs reporta serialização -->
    <Match>
        <Bug pattern="SE_NO_SERIALVERSIONID,SE_BAD_FIELD"/>
    </Match>

    <!-- Thymeleaf templates são carregados em runtime -->
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
        <Class name="~.*Controller"/>
    </Match>

    <!-- Entidades JPA — equals/hashCode gerados pelo Lombok/Hibernate -->
    <Match>
        <Bug pattern="HE_EQUALS_USE_HASHCODE,HE_HASHCODE_USE_OBJECT_EQUALS"/>
    </Match>

    <!-- DTOs e entities gerados com Lombok @Data -->
    <Match>
        <Class name="~.*Dto$"/>
        <Bug pattern="EQ_COMPARETO_USE_OBJECT_EQUALS"/>
    </Match>

    <!-- Exclusão de classes de teste -->
    <Match>
        <Class name="~.*Test$"/>
    </Match>
    <Match>
        <Class name="~.*IT$"/>
    </Match>

</FindBugsFilter>
