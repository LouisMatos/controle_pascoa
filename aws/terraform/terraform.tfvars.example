# openssl rand -hex 32 — obriga todo tráfego a passar pelo API Gateway.
# Vazio deixa a EC2 acessível direto pelo IP público.
gateway_shared_secret = "TROQUE-ME"

# Opcional: SMTP para notificações por email
mail_username = ""
mail_password = ""
